# Dedicated public Firebase project. Do not reuse a commercial production project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Required for deployed App Check. Debug mode still needs this provider configured.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_DEBUG=false

# Change without code edits when a Firebase-supported model is retired.
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite

# Optional browser-restricted key for the explicit nearby-workshop action.
VITE_GEOAPIFY_API_KEY=

# Clearly labelled UI-only fallback for local review. Never use as live AI evidence.
VITE_SYNTHETIC_DEMO=false
